{
    "name": "model/searchable",
    "description": "A Laravel package to make Eloquent models searchable using a simple trait",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sandezh",
            "email": "sandeshbhandari1000@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "illuminate/database": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^9.3 || ^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Model\\Searchable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Model\\Searchable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Model\\Searchable\\SiftServiceProvider"
            ]
        }
    },
    "keywords": [
        "laravel searchable",
        "laravel search",
        "model searchable",
        "model search",
        "eloquent searchable",
        "eloquent search",
        "laravel",
        "model",
        "searchable",
        "eloquent",
        "search"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
